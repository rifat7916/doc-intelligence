erDiagram
  documents ||--o{ document_pages : has
  documents ||--o{ invoices : contains
  documents ||--o{ validation_issues : has
  documents ||--o{ processing_events : logs
  documents ||--o{ chunks : indexed_as
  invoices ||--o{ line_items : has
  invoices ||--o{ validation_issues : has
  invoices ||--o{ corrections : audited_by
  invoices ||--o{ chunks : summarised_in
  documents {
    string id PK
    string filename
    string file_type
    string sha256
    string status
    string stage
    int progress
    int page_count
    int invoice_count
    bool needs_review
    json summary
    text error
    int processing_ms
  }
  document_pages {
    int id PK
    string document_id FK
    int page_no
    string source "digital or ocr or sheet"
    text text
    float ocr_confidence
  }
  invoices {
    string id PK
    string document_id FK
    string invoice_number
    date invoice_date
    string supplier_name
    string customer_name
    numeric subtotal
    numeric tax
    numeric total
    string currency
    json details "confidence and evidence per field"
    bool needs_review
    string review_status
  }
  line_items {
    int id PK
    string invoice_id FK
    int position
    text description
    numeric quantity
    numeric unit_price
    numeric amount
  }
  validation_issues {
    int id PK
    string document_id FK
    string invoice_id FK
    string code
    string severity
    string field
    text message
  }
  processing_events {
    int id PK
    string document_id FK
    string stage
    string status
    int duration_ms
    text message
  }
  corrections {
    int id PK
    string invoice_id FK
    string field
    text old_value
    text new_value
  }
  chunks {
    int id PK
    string document_id FK
    string invoice_id FK
    string kind "summary or text"
    text text
    vector embedding
    string embedding_model
  }
