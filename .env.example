# Copy to .env and fill in. Never commit .env.

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# tried in order if the main model is unavailable / out of quota
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# auto = Gemini when a key is set, otherwise deterministic rules | llm | rules
EXTRACTOR=auto

# --- Security ---
# Shared secret for the API (sent as X-API-Key). Leave empty ONLY for local experiments.
API_KEY=change-me-to-a-long-random-string
# Requests per minute per client IP (0 = off)
RATE_LIMIT_PER_MINUTE=600
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Database ---
# Set BEFORE the first `docker compose up` (letters and digits only). To change it later: docker compose down -v (this deletes the data).
POSTGRES_PASSWORD=change-me-db-password

# --- Tuning ---
OCR_THREADS=2
LLM_CONCURRENCY=4
MAX_UPLOAD_MB=200
